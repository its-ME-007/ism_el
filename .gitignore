# Python and local environments
__pycache__/
*.py[cod]
.venv/

# Test and tool scratch directories
.pytest-temp/
.pytest-tmp/
.pytest-cache/
.pytest-*/

# Downloaded/processed corpora and generated research artifacts stay local.
data/raw/*
!data/raw/**/SOURCE.md
data/processed/
results/*
# Metric JSONs are tracked: the paper's numbers come from them.
!results/metrics/
results/metrics/*.txt
